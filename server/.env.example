PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/trustlens

# JWT — use a cryptographically random 64-char string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_strong_random_secret_min_32_chars

# ML microservice (Python FastAPI, port 5001)
ML_SERVICE_URL=http://127.0.0.1:5001

# Allowed frontend origins (comma-separated). Default: localhost:5173
# CLIENT_ORIGIN=https://yourdomain.com
