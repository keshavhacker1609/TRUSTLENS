# API base URL — leave empty to use Vite dev proxy (recommended for local dev)
# In production, set to your deployed API origin: https://api.yourdomain.com/api
VITE_API_URL=

# WebSocket URL — leave empty to use window.location.origin (auto-detect)
# VITE_WS_URL=https://api.yourdomain.com

# Export base URL — leave empty to use relative paths (works with Vite proxy)
# VITE_API_EXPORT_BASE=https://api.yourdomain.com
